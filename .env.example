# Copiar como .env y completar. El .env no se sube al repositorio.

# Registro de la aplicacion en Microsoft Entra ID
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
VITE_AZURE_AUTHORITY=https://login.microsoftonline.com/TU_TENANT_ID
VITE_AZURE_SCOPE=api://TU_CLIENT_ID/read.write

# Microservicios. En local cada uno apunta a su puerto;
# en AWS los seis apuntan al mismo dominio del API Gateway pedidos360-api,
# cambiando solo el path.
VITE_MS_USUARIOS_URL=http://localhost:8081/api/v1/usuarios
VITE_MS_PRODUCTOS_URL=http://localhost:8082/api/v1/productos
VITE_MS_CARRITO_URL=http://localhost:8083/api/v1/carrito
VITE_MS_ORDENES_URL=http://localhost:8084/api/v1/ordenes
